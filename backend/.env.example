# ── Server ─────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────
MONGO_URI=mongodb://localhost:27017/shophub

# ── JWT ─────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_32chars_min
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── Client (CORS) ────────────────────────
CLIENT_URL=http://localhost:5173
